{
  "name": "obsidian-advanced-maps",
  "version": "1.0.0",
  "description": "Supercharge Obsidian's built-in Maps view: GPX/GeoJSON tracks, zoom-to-fit, Chinese coordinate systems and inline ![[track.gpx]] maps.",
  "main": "main.js",
  "license": "MIT",
  "author": "Jin1c-3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jin1c-3/obsidian-advanced-maps.git"
  },
  "bugs": {
    "url": "https://github.com/Jin1c-3/obsidian-advanced-maps/issues"
  },
  "homepage": "https://github.com/Jin1c-3/obsidian-advanced-maps#readme",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bases",
    "map",
    "gpx",
    "geojson",
    "gcj-02",
    "bd-09"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production --deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node .github/scripts/smoke-bundle.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && node .github/scripts/check-manifest.mjs && node esbuild.config.mjs production && npm run smoke",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.11.2",
    "obsidian": "latest",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
